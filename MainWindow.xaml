<Window x:Class="SafeTakeown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeTakeown"
        Icon="/app.ico"
        Height="720"
        Width="980"
        MinHeight="640"
        MinWidth="860"
        AllowDrop="True"
        Drop="Window_Drop"
        Background="#F3F4F6">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="18"
                BorderBrush="#D1D5DB"
                BorderThickness="1">

            <Grid>
                <!-- Content -->
                <StackPanel>
                    <TextBlock Text="SafeTakeown"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock Text="Transparent Windows permission cleanup helper"
                               FontSize="14"
                               Foreground="#6B7280"
                               Margin="0,4,0,0"/>

                    <TextBlock Text="Dry-run first. Dangerous system paths are blocked by default."
                               FontSize="13"
                               Foreground="#92400E"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Help Button (Top Right) -->
                <Button Content="? Help"
                        Width="75"
                        Height="26"
                        FontSize="14"
                        FontWeight="Bold"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0"
                        Click="Help_Click"
                        ToolTip="Help / About"/>
            </Grid>
        </Border>

        <!-- Main Controls -->
        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Path Panel -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="16"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Selected Path"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <TextBlock Text="Enter a path or drag and drop a file/folder into the window."
                               Foreground="#6B7280"
                               Margin="0,4,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="PathTextBox"
                                 Grid.Column="0"
                                 Height="34"
                                 FontSize="14"
                                 Padding="8,5"
                                 TextChanged="PathTextBox_TextChanged"/>
                        

                        <Button Content="Browse..."
                                Grid.Column="1"
                                Width="100"
                                Height="34"
                                Margin="8,0,0,0"
                                Click="Browse_Click"/>
                    </Grid>
                    <TextBlock x:Name="StatusTextBlock"
                               Margin="0,8,0,0"
                               FontWeight="SemiBold"
                               FontSize="13"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    
                        <Button Content="Dry Run"
                                Width="110"
                                Height="34"
                                Margin="8,0,0,0"
                                Click="DryRun_Click"/>

                        <Button Content="Take Ownership"
                                Width="150"
                                Height="34"
                                Margin="8,0,0,0"
                                Click="TakeOwnership_Click"/>
                    </StackPanel>

                    <Separator Margin="0,16,0,14"/>

                    <TextBlock Text="Deletion"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <TextBlock Text="Use only after validating the path. Delete on reboot helps with locked files."
                               Foreground="#6B7280"
                               Margin="0,4,0,10"/>

                    <StackPanel>
                        <ComboBox x:Name="DeleteModeComboBox"
                                  Height="32"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Normal Delete"/>
                            <ComboBoxItem Content="Secure Delete - 1 Pass"/>
                        </ComboBox>
             
                        <TextBlock Text="Secure Delete overwrites the file once before deletion. Not guaranteed on SSDs."
                                   TextWrapping="Wrap"
                                   Foreground="#92400E"
                                   Margin="0,6,0,10"/>

                                   <StackPanel Orientation="Horizontal">
                            <Button Content="Delete Selected"
                                    Width="130"
                                    Height="34"
                                    Click="Delete_Click"/>

                            <Button Content="Delete on Reboot"
                                    Width="150"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    Click="DeleteOnReboot_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Safety / Tools Panel -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="16"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Safety"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <CheckBox x:Name="ExpertModeCheckBox"
                              Content="Expert Mode"
                              Margin="0,10,0,0"
                              Checked="ExpertModeChanged"
                              Unchecked="ExpertModeChanged"/>

                    <TextBlock Text="Allows ExpertOnly paths, but Windows core paths remain blocked."
                               TextWrapping="Wrap"
                               Foreground="#6B7280"
                               Margin="0,6,0,0"/>

                    <Separator Margin="0,18,0,14"/>

                    <TextBlock Text="Recycle Bin Repair"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#111827"/>

                    <TextBlock Text="Reset a broken recycle bin on one selected drive."
                               TextWrapping="Wrap"
                               Foreground="#6B7280"
                               Margin="0,4,0,10"/>

                    <ComboBox x:Name="RecycleBinDriveComboBox"
                              Height="32"
                              Width="120"
                              HorizontalAlignment="Left"/>

                    <Button Content="Repair Recycle Bin"
                            Height="34"
                            Margin="0,10,0,0"
                            Click="RepairRecycleBin_Click"/>

                    <Separator Margin="0,18,0,14"/>

                    <Button Content="Export Log"
                            Height="34"
                            Click="ExportLog_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Log -->
        <Border Grid.Row="2"
                Background="#111827"
                CornerRadius="10"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Operation Log"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="LogTextBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         Background="#030712"
                         Foreground="#D1D5DB"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="13"
                         Padding="10"/>
            </Grid>
        </Border>
    </Grid>
</Window>