<Window x:Class="SafeTakeown.BrowseChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browse"
        Height="180"
        Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="What do you want to select?"
                   FontSize="16"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Folder" Width="90" Height="32" Margin="0,0,8,0" Click="Folder_Click"/>
            <Button Content="File" Width="90" Height="32" Margin="0,0,8,0" Click="File_Click"/>
            <Button Content="Cancel" Width="90" Height="32" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>